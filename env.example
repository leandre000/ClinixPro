# ClinixPro Environment Configuration
# Copy this file to .env.local for local development
# For production, set these variables in your hosting platform

# ==================== APPLICATION CONFIGURATION ====================
APP_NAME=ClinixPro
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
NODE_ENV=development

# ==================== FRONTEND CONFIGURATION ====================
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME=ClinixPro
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENVIRONMENT=development

# ==================== BACKEND CONFIGURATION ====================
# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
SPRING_PROFILES_ACTIVE=development

# ==================== DATABASE CONFIGURATION ====================
# Local Development Database
DATABASE_URL=jdbc:postgresql://localhost:5434/clinixpro
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=leandre
DATABASE_NAME=clinixpro

# Production Database (Render)
# DATABASE_URL=jdbc:postgresql://your-render-db-url:5432/clinixpro
# DATABASE_USERNAME=clinixpro_user
# DATABASE_PASSWORD=your-production-password

# ==================== JWT CONFIGURATION ====================
JWT_SECRET=364115689b626958012b9d7feb17d295d8889060cd1806a1a42d155898d52188d1ceada7ed4709073cdd26572bdc
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==================== EMAIL CONFIGURATION ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=clinixpro@hospital.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=clinixpro@hospital.com
MAIL_FROM_NAME=ClinixPro System

# ==================== CORS CONFIGURATION ====================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://clinixpro.vercel.app,https://clinixpro.com
SPRING_WEB_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
SPRING_WEB_CORS_ALLOWED_HEADERS=*
SPRING_WEB_CORS_ALLOW_CREDENTIALS=true

# ==================== SECURITY CONFIGURATION ====================
SECURITY_USER=admin
SECURITY_PASSWORD=admin123
BCRYPT_ROUNDS=12

# ==================== FILE UPLOAD CONFIGURATION ====================
MAX_FILE_SIZE=10485760
MAX_REQUEST_SIZE=10485760
UPLOAD_DIRECTORY=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ==================== LOGGING CONFIGURATION ====================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/clinixpro.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# ==================== CACHE CONFIGURATION ====================
CACHE_TYPE=caffeine
CACHE_MAX_SIZE=1000
CACHE_EXPIRE_AFTER_WRITE=1800
CACHE_EXPIRE_AFTER_ACCESS=900

# ==================== MONITORING CONFIGURATION ====================
ENABLE_HEALTH_CHECK=true
ENABLE_METRICS=true
ENABLE_ACTUATOR=true
HEALTH_CHECK_PATH=/api/health

# ==================== DEVELOPMENT TOOLS ====================
ENABLE_DEV_TOOLS=true
ENABLE_H2_CONSOLE=false
ENABLE_SWAGGER=true
SWAGGER_PATH=/api/swagger-ui.html

# ==================== PERFORMANCE CONFIGURATION ====================
DATABASE_CONNECTION_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=600000
DATABASE_MAX_LIFETIME=1800000

# ==================== EXTERNAL SERVICES ====================
# Google OAuth (if using)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMS Service (if using)
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# Payment Gateway (if using)
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# ==================== FEATURE FLAGS ====================
ENABLE_USER_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_AUDIT_LOGGING=true

# ==================== INTEGRATION URLs ====================
# Development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Production (update these after deployment)
# FRONTEND_URL=https://clinixpro.vercel.app
# BACKEND_URL=https://clinixpro-backend.onrender.com 